# Heisenberg Pre-Production Management — Environment Variables Template
# Copy this file to .env and fill in your Supabase project credentials.

# -----------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from your Supabase Dashboard: Settings -> API
# -----------------------------------------------------------------------------

# Client-side (Vite build-time & browser runtime)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Server-side (SSR / Server Functions)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional: Server-side admin operations (bypasses Row-Level Security, keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Nitro Deployment Target (Optional)
# Supported presets: node-server, vercel, netlify, cloudflare-pages, cloudflare-module
# Defaults to "node-server"
# -----------------------------------------------------------------------------
# NITRO_PRESET=node-server
